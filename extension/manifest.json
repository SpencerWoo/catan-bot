{
  "manifest_version": 3,
  "name": "Catan Copilot v1.27 for colonist.io",
  "version": "0.3.1",
  "description": "Live card counting, dice tracking, placement advice, and optional experimental autopilot for colonist.io, with a local coaching bridge.",
  "browser_specific_settings": {
    "gecko": {
      "id": "catan-copilot@nbroa025.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteContent",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8137/*",
    "http://localhost:8137/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.colonist.io/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.colonist.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
